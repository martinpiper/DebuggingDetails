!macro SafeWord .a,.b,.c,.d {
	!word .a & 0xffff,.b & 0xffff,.c & 0xffff,.d & 0xffff
}
!macro SafeWord .a,.b,.c {
	!word .a & 0xffff,.b & 0xffff,.c & 0xffff
}
!macro SafeWord .a,.b {
	!word .a & 0xffff,.b & 0xffff
}
!macro SafeWord .a {
	!word .a & 0xffff
}
